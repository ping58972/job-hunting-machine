# Optional local overrides. Copy to .env; never commit credentials.
# Process JHM_* variables override .env, which overrides YAML configuration.
JHM_RUNTIME_MODE=DRY_RUN
JHM_LOG_LEVEL=INFO
# The project root is fixed by Architecture v2 and cannot be overridden here.
# Phase 3 defaults to mock model transport. Runtime modes alone never enable OpenAI.
# For explicit ModelGateway.for_openai use, supply these in the process environment.
# They are not automatically loaded by the gateway from this file.
OPENAI_ALLOW_LIVE=0
# OPENAI_API_KEY=  # Supply securely; never commit a real value.

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.job-hunting-machine.monitor-schedule</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/ping58972/Documents/job-hunting-machine &amp;&amp; mkdir -p .tmp logs &amp;&amp; TMPDIR="$PWD/.tmp" exec /opt/homebrew/bin/uv run --locked jhm monitor schedule</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/ping58972/Documents/job-hunting-machine/logs/launchd-monitor.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ping58972/Documents/job-hunting-machine/logs/launchd-monitor.err.log</string>
</dict>
</plist>
